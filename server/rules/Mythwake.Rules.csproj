<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Stateless rules service: runs the exact client rules (Assets/Mythwake/Runtime/Core + Content) for the Go API. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Mythwake.Rules</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Mythwake/Runtime/Core/**/*.cs" LinkBase="Shared/Core" />
    <Compile Include="../../Assets/Mythwake/Runtime/Content/**/*.cs" LinkBase="Shared/Content" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
