* text=auto

# Unity text assets should stay diffable.
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf

# Binary assets
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.tga binary
*.tif binary
*.tiff binary
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.mp3 binary
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg binary
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov binary
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.jpeg binary
