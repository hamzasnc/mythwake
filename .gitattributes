* text=auto

# Unity text assets should stay diffable.
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.fbx binary
*.blend binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary

# Opt-in LFS policy for future large authored art. Existing repository history
# stays as normal Git blobs; only files added under this directory use LFS.
Assets/_Mythwake/Art/Large/*.png filter=lfs diff=lfs merge=lfs -text
Assets/_Mythwake/Art/Large/*.jpg filter=lfs diff=lfs merge=lfs -text
Assets/_Mythwake/Art/Large/*.jpeg filter=lfs diff=lfs merge=lfs -text
Assets/_Mythwake/Art/Large/*.psd filter=lfs diff=lfs merge=lfs -text
Assets/_Mythwake/Art/Large/*.fbx filter=lfs diff=lfs merge=lfs -text
Assets/_Mythwake/Art/Large/*.blend filter=lfs diff=lfs merge=lfs -text
