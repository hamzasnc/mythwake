/* Mythwake UI theme. Colors are tokens on the root; components use classes only. */

:root {
    --bg: #0d1220;
    --panel: rgba(22, 29, 49, 0.94);
    --panel-light: rgba(38, 48, 78, 0.95);
    --line: rgba(232, 194, 106, 0.35);
    --gold: #e8c26a;
    --gold-dark: #9c7a2e;
    --text: #f1ead8;
    --muted: #a6a9b8;
    --good: #6fdc7a;
    --bad: #ff6b6b;
    --common: #9aa3ad;
    --rare: #4ea4ff;
    --epic: #b46cff;
    --legendary: #ffb93b;
    --transcendent: #ff5e7e;
    color: var(--text);
    font-size: 30px;
}

.screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column;
}

.screen--solid {
    background-color: var(--bg);
}

.safe {
    flex-grow: 1;
    padding: 24px 28px;
    flex-direction: column;
}

/* ---------------------------------------------------------------- top bar */

.currency-bar {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
    flex-wrap: wrap;
    padding: 18px 20px 6px 20px;
}

.currency {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 26px;
    padding: 6px 20px 6px 8px;
    margin-left: 12px;
    margin-bottom: 8px;
    border-width: 2px;
    border-color: var(--line);
}

.currency__icon {
    width: 36px; height: 36px;
    border-radius: 18px;
    margin-right: 10px;
}

.currency__value {
    font-size: 28px;
    -unity-font-style: bold;
}

.icon--gold { background-color: #f2c14e; }
.icon--heroExp { background-color: #7fd36b; }
.icon--gems { background-color: #6ad1ff; }
.icon--summonScroll { background-color: #d59cff; }
.icon--fragmentDust { background-color: #ff8fb1; }

/* ---------------------------------------------------------------- panels and buttons */

.panel {
    background-color: var(--panel);
    border-radius: 22px;
    border-width: 2px;
    border-color: var(--line);
    padding: 24px;
    margin-bottom: 20px;
}

.title {
    font-size: 46px;
    -unity-font-style: bold;
    color: var(--gold);
    margin-bottom: 8px;
}

.subtitle {
    font-size: 30px;
    color: var(--muted);
}

.label--small { font-size: 24px; color: var(--muted); }
.label--good { color: var(--good); }
.label--bad { color: var(--bad); }

.btn {
    background-color: var(--gold);
    color: #2a1d05;
    border-radius: 18px;
    border-width: 0;
    padding: 16px 36px;
    margin: 6px;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.08s;
    transition-property: scale, background-color;
}

.btn:hover { background-color: #f3d48a; }
.btn:active { scale: 0.95 0.95; }
.btn:disabled { background-color: #5b5544; color: #a59f8b; }

.btn--secondary {
    background-color: var(--panel-light);
    color: var(--text);
    border-width: 2px;
    border-color: var(--line);
}

.btn--secondary:hover { background-color: #3a4876; }

.btn--big {
    font-size: 44px;
    padding: 22px 60px;
}

.btn--small {
    font-size: 26px;
    padding: 10px 20px;
}

.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.center { align-items: center; justify-content: center; }
.spacer { flex-grow: 1; }

/* ---------------------------------------------------------------- bottom navigation */

.nav {
    flex-shrink: 0;
    flex-direction: row;
    background-color: rgba(10, 13, 24, 0.97);
    border-top-width: 2px;
    border-color: var(--line);
    padding: 10px 10px 26px 10px;
}

.nav__item {
    flex-grow: 1;
    flex-basis: 0;
    background-color: transparent;
    border-width: 0;
    color: var(--muted);
    font-size: 27px;
    padding: 18px 0;
    -unity-text-align: middle-center;
}

.nav__item--active {
    color: var(--gold);
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------- home */

.stage-card {
    align-items: center;
    padding: 34px 24px;
}

.stage-card__number {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--text);
}

.boss-tag {
    background-color: var(--bad);
    color: white;
    border-radius: 10px;
    padding: 4px 16px;
    font-size: 24px;
    -unity-font-style: bold;
    margin-top: 6px;
}

.afk-rewards {
    flex-direction: row;
    justify-content: center;
    margin: 14px 0;
}

.afk-progress {
    height: 16px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 8px;
    margin: 10px 0 16px 0;
}

.afk-progress__fill {
    height: 100%;
    background-color: var(--gold);
    border-radius: 8px;
}

/* ---------------------------------------------------------------- hero cards */

.hero-card {
    width: 172px;
    height: 224px;
    margin: 8px;
    border-radius: 18px;
    border-width: 4px;
    border-color: var(--common);
    background-color: #1d2540;
    overflow: hidden;
    justify-content: flex-end;
}

.hero-card--rare { border-color: var(--rare); }
.hero-card--epic { border-color: var(--epic); }
.hero-card--legendary { border-color: var(--legendary); }
.hero-card--transcendent { border-color: var(--transcendent); }
.hero-card--selected { opacity: 0.4; }

.hero-card__portrait {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.hero-card__initial {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 40px;
    font-size: 90px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.35);
}

.hero-card__footer {
    background-color: rgba(0, 0, 0, 0.72);
    padding: 4px 8px;
    flex-direction: row;
    justify-content: space-between;
}

.hero-card__name {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-overflow-position: end;
    overflow: hidden;
    white-space: nowrap;
}

.hero-card__level { font-size: 22px; color: var(--gold); }

.hero-card__stars {
    position: absolute;
    top: 6px; left: 8px;
    color: var(--legendary);
    font-size: 22px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: black;
}

.aspect-dot {
    position: absolute;
    top: 8px; right: 8px;
    width: 28px; height: 28px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.6);
}

.aspect--ravak { background-color: #ff6a3d; }
.aspect--gorath { background-color: #6fcf5b; }
.aspect--somnara { background-color: #7a8cff; }
.aspect--veloria { background-color: #ff7ad9; }
.aspect--envyra { background-color: #3fe0c5; }

.hero-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* ---------------------------------------------------------------- formation */

.formation {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin: 10px 0;
}

.formation__column {
    flex-direction: column;
    align-items: center;
    margin: 0 18px;
}

.slot {
    width: 172px;
    height: 224px;
    margin: 8px;
    border-radius: 18px;
    border-width: 3px;
    border-color: var(--line);
    background-color: rgba(0, 0, 0, 0.35);
    align-items: center;
    justify-content: center;
}

.slot--locked {
    opacity: 0.45;
}

.slot .hero-card { margin: 0; width: 100%; height: 100%; }

.synergy {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.synergy__chip {
    background-color: var(--panel-light);
    border-radius: 14px;
    padding: 6px 14px;
    margin: 4px;
    font-size: 24px;
}

.synergy__chip--active { color: var(--good); border-width: 2px; border-color: var(--good); }

/* ---------------------------------------------------------------- battle hud */

.hud-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 30px 24px 0 24px;
}

.hud-bottom {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    flex-direction: row;
    justify-content: center;
    padding: 0 10px 40px 10px;
}

.ult-button {
    width: 168px;
    height: 200px;
    margin: 0 6px;
    border-radius: 18px;
    border-width: 4px;
    border-color: #2b3350;
    background-color: #1d2540;
    overflow: hidden;
    justify-content: flex-end;
    transition-duration: 0.12s;
    transition-property: scale, border-color, translate;
}

.ult-button--ready {
    border-color: var(--gold);
    translate: 0 -14px;
}

.ult-button--dead { opacity: 0.3; }

.ult-button__energy {
    height: 14px;
    background-color: rgba(0, 0, 0, 0.7);
}

.ult-button__energy-fill {
    height: 100%;
    background-color: #59a8ff;
}

.ult-button__hp {
    height: 10px;
    background-color: rgba(0, 0, 0, 0.7);
}

.ult-button__hp-fill {
    height: 100%;
    background-color: var(--good);
}

.floating {
    position: absolute;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    -unity-text-align: middle-center;
    width: 300px;
    margin-left: -150px;
}

.floating--damage { color: #ffffff; }
.floating--advantage { color: #ffd2a8; }
.floating--crit { color: #ffcd3c; font-size: 64px; }
.floating--heal { color: #7dff8c; }
.floating--shield { color: #cfe3ff; font-size: 34px; }
.floating--miss { color: #c0c4d0; font-size: 34px; }

.cutin {
    position: absolute;
    left: 0; right: 0; top: 30%; height: 34%;
    background-color: rgba(8, 10, 20, 0.85);
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-color: var(--gold);
    overflow: hidden;
    transition-duration: 0.18s;
    transition-property: translate, opacity;
}

.cutin__image {
    position: absolute;
    left: -10%; top: -10%; right: -10%; bottom: -10%;
    -unity-background-scale-mode: scale-and-crop;
}

.cutin__text {
    position: absolute;
    right: 40px; bottom: 30px;
    align-items: flex-end;
}

.cutin__name {
    font-size: 64px;
    -unity-font-style: bold;
    color: var(--gold);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: black;
}

.cutin__skill {
    font-size: 40px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: black;
}

/* ---------------------------------------------------------------- popups */

.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
    align-items: center;
    justify-content: center;
}

.popup {
    width: 88%;
    max-width: 960px;
    align-items: center;
}

.result-title {
    font-size: 96px;
    -unity-font-style: bold;
}

.result-title--victory { color: var(--gold); }
.result-title--defeat { color: var(--bad); }

.reward {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 16px;
    padding: 10px 18px;
    margin: 6px;
}

.toast {
    position: absolute;
    left: 10%; right: 10%; top: 12%;
    background-color: rgba(120, 30, 30, 0.95);
    border-radius: 16px;
    padding: 18px;
    -unity-text-align: middle-center;
    font-size: 30px;
    transition-duration: 0.25s;
    transition-property: opacity;
}

/* ---------------------------------------------------------------- hero detail */

.hero-art {
    height: 720px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 10px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.skill {
    padding: 14px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.skill__slot { font-size: 22px; color: var(--gold); }
.skill__name { font-size: 32px; -unity-font-style: bold; }
.skill__text { font-size: 26px; color: var(--muted); white-space: normal; }

.tag {
    background-color: var(--panel-light);
    border-radius: 10px;
    padding: 4px 12px;
    margin: 4px 8px 4px 0;
    font-size: 24px;
}

.grade--common { color: var(--common); }
.grade--rare { color: var(--rare); }
.grade--epic { color: var(--epic); }
.grade--legendary { color: var(--legendary); }
.grade--transcendent { color: var(--transcendent); }

/* ---------------------------------------------------------------- summon */

.banner {
    height: 560px;
    border-radius: 24px;
    overflow: hidden;
    justify-content: flex-end;
    background-color: #241a3d;
    border-width: 3px;
    border-color: var(--epic);
}

.banner__art {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.85;
}

.banner__info {
    background-color: rgba(0, 0, 0, 0.6);
    padding: 20px;
}

.new-badge {
    position: absolute;
    top: 6px; right: 6px;
    background-color: var(--bad);
    color: white;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 20px;
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------- village */

.icon--wood { background-color: #b07a45; }
.icon--stone { background-color: #9aa3ad; }

.building--ruin { border-color: rgba(255, 255, 255, 0.12); }
.building--planned { opacity: 0.55; }

.building__name {
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--gold);
}

.building__level {
    font-size: 28px;
    color: var(--muted);
}

.building__slots {
    margin: 12px 0;
}

.slot--small {
    width: 128px;
    height: 166px;
    margin: 0 10px 0 0;
}

.slot__plus {
    font-size: 64px;
    color: var(--muted);
}

.slot__bonus {
    position: absolute;
    bottom: 34px; left: 0; right: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: var(--good);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: black;
}

.cost {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 14px;
    padding: 6px 14px 6px 6px;
    margin-right: 8px;
}

.cost__value { color: var(--text); }

/* ---------------------------------------------------------------- gear */

.gear-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.gear {
    width: 23%;
    min-width: 200px;
    min-height: 150px;
    margin: 6px 0;
    padding: 10px 12px;
    border-radius: 14px;
    border-width: 3px;
    border-color: var(--common);
    background-color: #1d2540;
}

.hero-grid .gear { width: 220px; margin: 6px; }

.gear--empty {
    border-color: rgba(255, 255, 255, 0.15);
    align-items: center;
    justify-content: center;
}

.gear__slot { font-size: 24px; -unity-font-style: bold; }
.gear__icon { width: 96px; height: 96px; align-self: center; margin-top: 4px; -unity-background-scale-mode: scale-to-fit; }
.gear__level { font-size: 24px; color: var(--gold); -unity-font-style: bold; }
.gear__stat { font-size: 24px; margin-top: 8px; white-space: normal; }
.gear__set { font-size: 18px; color: var(--muted); margin-top: 6px; white-space: normal; }
.gear__owner { font-size: 18px; color: var(--gold); margin-top: 4px; }

.forge { margin-top: 12px; }

.icon--gearMaterials { background-color: #7fb0c9; }

/* ---------------------------------------------------------------- quests */

.quest-strip {
    flex-direction: row;
    align-items: center;
    padding: 14px 18px;
}

.quest__title { font-size: 30px; -unity-font-style: bold; white-space: normal; }
.quest__points { font-size: 30px; color: var(--gold); -unity-font-style: bold; }
.quest__done { font-size: 44px; color: var(--good); margin: 0 18px; }
.quest--claimed { opacity: 0.55; }

.badge {
    position: absolute;
    top: -6px; right: -6px;
    width: 22px; height: 22px;
    border-radius: 11px;
    background-color: var(--bad);
    border-width: 2px;
    border-color: white;
}

.tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin: 10px 0 14px 0;
}

.tab {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--panel-light);
    color: var(--muted);
    border-width: 2px;
    border-color: var(--line);
    font-size: 28px;
    padding: 12px 0;
}

.tab--active {
    background-color: var(--gold);
    color: #2a1d05;
}

.chests {
    justify-content: space-between;
    margin-top: 6px;
}

.chest {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px;
    padding: 8px;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    align-items: center;
}

.chest--ready { border-color: var(--gold); background-color: rgba(232, 194, 106, 0.18); }
.chest--claimed { opacity: 0.4; }
.chest__points { font-size: 26px; -unity-font-style: bold; color: var(--gold); }
.chest__value { font-size: 22px; }

.quest-strip .btn { flex-shrink: 0; }
.quest-strip .grow { flex-shrink: 1; min-width: 0; }

.pill {
    flex-shrink: 0;
    background-color: var(--panel-light);
    border-radius: 16px;
    border-width: 2px;
    border-color: var(--line);
    padding: 10px 20px;
    font-size: 26px;
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------- hunts */

.hunt--elite { border-color: var(--bad); }
.hunt__stars { font-size: 30px; color: var(--legendary); }
.icon--huntTokens { background-color: #d9784a; }

/* ---------------------------------------------------------------- arena */

.arena__rank { font-size: 52px; -unity-font-style: bold; color: var(--gold); }
.arena__team { flex-wrap: wrap; margin: 8px 0; }
.hero-card--mini { width: 96px; height: 124px; margin: 4px; border-width: 3px; }
.hero-card--mini .hero-card__stars { font-size: 14px; }
.ranking__row { align-items: center; padding: 14px 20px; margin-bottom: 8px; }
.ranking__place { font-size: 34px; -unity-font-style: bold; color: var(--muted); width: 80px; }
.boot { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.icon--arenaCoins { background-color: #e86a6a; }

/* ---------------------------------------------------------------- dungeons and adventure hub */

.dungeon { align-items: stretch; }
.dungeon__art {
    height: 420px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 8px;
}
.dungeon__name { font-size: 40px; -unity-font-style: bold; color: var(--gold); }
.dungeon__selector { margin: 12px 0; }
.dungeon__level { font-size: 40px; -unity-font-style: bold; width: 260px; -unity-text-align: middle-center; }
.dungeon__rewards { align-items: flex-start; margin: 8px 0; }

.mode {
    flex-direction: row;
    align-items: center;
    padding: 16px;
}
.mode__art {
    width: 190px;
    height: 190px;
    margin-right: 18px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 16px;
}

/* ---------------------------------------------------------------- hub maps (town, world map) */

.map {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
}
.map__canvas {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}
/* until the painted pictures exist */
.map__canvas--town { background-color: #2f4a2b; }
.map__canvas--world { background-color: #1e3247; }

.map-title {
    align-self: center;
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--gold);
    background-color: rgba(10, 13, 24, 0.78);
    border-radius: 24px;
    border-width: 2px;
    border-color: var(--line);
    padding: 6px 36px;
}

.popup-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.town-building {
    align-items: center;
    justify-content: flex-end;
}
.town-building__art {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.1s;
    transition-property: scale;
}
.town-building:active .town-building__art { scale: 0.96 0.96; }
.town-building--ruin .town-building__art { -unity-background-image-tint-color: rgb(170, 160, 150); }
.town-building__placeholder {
    position: absolute;
    left: 8%; top: 25%; right: 8%; bottom: 0;
    background-color: rgba(120, 90, 60, 0.85);
    border-radius: 24px;
    border-width: 3px;
    border-color: rgba(40, 25, 10, 0.9);
}
.town-building--ruin .town-building__placeholder { background-color: rgba(60, 55, 50, 0.85); }
.town-building__plate {
    align-items: center;
    background-color: rgba(10, 13, 24, 0.86);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--line);
    padding: 2px 16px 4px 16px;
    margin-bottom: -18px;
}
.town-building--ruin .town-building__plate { border-color: rgba(255, 255, 255, 0.18); }
.town-building__name {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--gold);
    white-space: nowrap;
}
.town-building--ruin .town-building__name { color: var(--muted); }
.town-building__level { font-size: 20px; color: var(--text); white-space: nowrap; }

.town-bubble {
    background-color: rgba(255, 246, 220, 0.96);
    color: #3a2a0a;
    border-radius: 26px;
    border-width: 3px;
    border-color: var(--gold-dark);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 4px 10px;
}

.building-popup {
    width: 92%;
    max-width: 980px;
    max-height: 82%;
}
.building-popup .building { margin-bottom: 0; }
.building-popup__close {
    position: absolute;
    right: 8px; top: 8px;
    width: 64px; height: 64px;
    padding: 0;
    font-size: 38px;
}
.building__art {
    height: 340px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 8px;
}

.map-pin { align-items: center; }
.map-pin__frame {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    border-width: 5px;
    border-color: var(--gold);
    background-color: rgba(10, 13, 24, 0.82);
    overflow: hidden;
    transition-duration: 0.1s;
    transition-property: scale;
}
.map-pin:active .map-pin__frame { scale: 0.95 0.95; }
.map-pin__art {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}
.map-pin--locked .map-pin__frame { border-color: #5b5544; }
.map-pin--locked .map-pin__art { -unity-background-image-tint-color: rgb(90, 90, 100); }
.map-pin__under {
    position: absolute;
    left: -60%; right: -60%; top: 86%;
    align-items: center;
}
.map-pin__plate {
    align-items: center;
    background-color: rgba(10, 13, 24, 0.88);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--line);
    padding: 2px 16px 4px 16px;
}
.map-pin__name { font-size: 26px; -unity-font-style: bold; color: var(--gold); white-space: nowrap; }
.map-pin--locked .map-pin__name { color: var(--muted); }
.map-pin__hint { font-size: 18px; color: var(--muted); white-space: normal; -unity-text-align: middle-center; max-width: 300px; }

/* centre campaign button, raised like AFK Arena */
.nav { align-items: flex-end; }
.nav__item { font-size: 24px; }
.nav__item--main {
    flex-grow: 1.3;
    height: 128px;
    margin-top: -46px;
    border-radius: 64px;
    border-width: 4px;
    border-color: var(--gold);
    background-color: #2a2312;
    color: var(--gold);
    font-size: 27px;
    -unity-font-style: bold;
}
.nav__item--main.nav__item--active { background-color: var(--gold-dark); color: white; }

/* ---------------------------------------------------------------- fragments */

.fragment {
    width: 31%;
    min-width: 200px;
    min-height: 210px;
    margin: 6px 0;
    padding: 10px 12px;
    border-radius: 14px;
    border-width: 3px;
    border-color: var(--common);
    background-color: rgba(0, 0, 0, 0.3);
    align-items: center;
}
.hero-grid .fragment { width: 220px; margin: 6px; }
.fragment > .row { align-self: stretch; }
.fragment__aspect { font-size: 20px; -unity-font-style: bold; }
.fragment__name { font-size: 22px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.fragment__icon {
    width: 104px; height: 104px;
    margin: 4px 0;
    -unity-background-scale-mode: scale-to-fit;
}
.fragment__icon--big {
    width: 150px; height: 150px;
    margin-right: 18px;
    -unity-background-scale-mode: scale-to-fit;
}
.fragment__icon--placeholder { border-radius: 20px; rotate: 45deg; scale: 0.7 0.7; }
.fragment__pick {
    position: absolute;
    top: -10px; left: -10px;
    width: 44px; height: 44px;
    border-radius: 22px;
    background-color: var(--gold);
    color: #2a1d05;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.fragment-details { align-self: stretch; margin-bottom: 10px; }
.icon--fragmentDust { background-color: #ff8fb1; }

/* ---------------------------------------------------------------- relics */

.gear-row .fragment { width: 23%; min-width: 0; }
.relic__icon--placeholder { background-color: rgba(232, 194, 106, 0.4); border-radius: 60px; }
.relic-card--missing { opacity: 0.5; }
.relic-copy {
    margin-top: 8px;
    padding: 6px 12px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 12px;
}
.icon--relicMaterials { background-color: #e0a65a; }

/* ---------------------------------------------------------------- realms */

.icon--realmKey { background-color: #9b6bff; }
.icon--guardianSigil { background-color: #7ad7ff; }
.realm { border-color: rgba(155, 107, 255, 0.55); }

/* ---------------------------------------------------------------- summon focus */

.focus-row { flex-wrap: wrap; margin-bottom: 10px; }
.focus-chip { font-size: 22px; padding: 8px 14px; margin: 4px; }
.focus-chip--active { background-color: var(--gold); color: #2a1d05; }

/* ---------------------------------------------------------------- leader abilities */

.leader-banner {
    position: absolute;
    left: 24px; top: 22%;
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 13, 24, 0.88);
    border-radius: 20px;
    border-width: 2px;
    border-color: var(--gold);
    padding: 8px 22px 8px 8px;
    transition-duration: 0.35s;
    transition-property: opacity;
}
.leader-banner__portrait {
    width: 84px; height: 105px;
    border-radius: 12px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-and-crop;
}
.leader-banner__text { font-size: 30px; -unity-font-style: bold; color: var(--gold); }

/* ---------------------------------------------------------------- guardian awakening */

.hero-card--awakened {
    border-color: #ff5e7e;
    border-width: 4px;
    background-color: rgba(255, 94, 126, 0.18);
}
.awakening { border-color: rgba(255, 94, 126, 0.6); }

/* ---------------------------------------------------------------- boss fragments */

.boss-fragment--equipped { border-color: var(--gold); border-width: 4px; }
.leader-banner--boss { top: 30%; border-color: #9b6bff; }

/* ---------------------------------------------------------------- defense */

.defense-hp { height: 10px; margin: 4px 6px; }
.defense--fallen { opacity: 0.45; }

/* ---------------------------------------------------------------- shops */

.map-title-row { align-self: center; }
.map-shop { margin-left: 14px; }
.shop-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.shop-item {
    width: 48%;
    align-items: center;
    padding: 16px;
    margin-bottom: 14px;
}
.shop-item__icon {
    width: 120px; height: 120px;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}
.shop-item__currency { width: 72px; height: 72px; border-radius: 36px; margin: 0; }
.shop-item__name { font-size: 26px; -unity-font-style: bold; color: var(--gold); white-space: normal; -unity-text-align: middle-center; }
.icon--upgradeStones { background-color: #b9c3d6; }

/* ---------------------------------------------------------------- guild */

.guild-input { margin: 8px 0; font-size: 28px; }
.guild-input > .unity-text-field__input { background-color: rgba(0, 0, 0, 0.35); color: var(--text); border-color: var(--line); padding: 10px; }
.guild-row { align-items: center; }
.guild-chat { min-height: 300px; margin-bottom: 10px; }
.guild-message { background-color: var(--panel-light); border-radius: 14px; padding: 8px 14px; margin-bottom: 8px; }
.guild-message__name { font-size: 22px; color: var(--gold); -unity-font-style: bold; }
.raid-hp { height: 26px; margin: 10px 0 4px 0; }
.raid-hp__fill { background-color: #e5484d; }
.icon--guildCoins { background-color: #c9a227; }

/* ---------------------------------------------------------------- intro story */

.story {
    background-color: #05070d;
}

.story__picture {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.story__panel {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 48px 48px 64px 48px;
    background-color: rgba(5, 7, 13, 0.82);
    border-top-width: 2px;
    border-color: var(--line);
    align-items: center;
}

.story__text {
    font-size: 34px;
    white-space: normal;
    -unity-text-align: middle-center;
    opacity: 0;
    translate: 0 16px;
    transition-duration: 0.6s;
    transition-property: opacity, translate;
}

.story__text--in {
    opacity: 1;
    translate: 0 0;
}

.story__dots {
    flex-direction: row;
    margin-top: 28px;
}

.story__dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin: 0 8px;
    background-color: rgba(255, 255, 255, 0.25);
}

.story__dot--on { background-color: var(--gold); }

.story__hint {
    margin-top: 18px;
    color: var(--muted);
}

.story__skip {
    position: absolute;
    top: 48px;
    right: 32px;
}

/* ---------------------------------------------------------------- coach marks */

.coach {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.coach__ring {
    position: absolute;
    border-width: 6px;
    border-color: var(--gold);
    border-radius: 24px;
    transition-duration: 0.6s;
    transition-property: scale, opacity;
    scale: 1 1;
    opacity: 1;
}

.coach__ring--big {
    scale: 1.08 1.08;
    opacity: 0.55;
}

.coach__bubble {
    position: absolute;
    background-color: var(--panel-light);
    border-width: 3px;
    border-color: var(--gold);
    border-radius: 20px;
    padding: 20px 24px;
    align-items: center;
}

.coach__text {
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 30px;
}

.coach__bubble .btn {
    margin-top: 14px;
}

/* ================================================================ UI kit (Content/UI, docs/UI_KIT.md) */

/* currency icons */
.icon--gold { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/gold.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--heroExp { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/heroExp.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--gems { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/gems.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--summonScroll { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/summonScroll.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--fragmentDust { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/fragmentDust.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--wood { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/wood.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--stone { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/stone.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--guardianSigil { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/guardianSigil.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--gearMaterials { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/gearMaterials.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--relicMaterials { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/relicMaterials.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--upgradeStones { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/upgradeStones.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--huntTokens { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/huntTokens.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--arenaCoins { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/arenaCoins.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--guildCoins { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/guildCoins.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--realmKey { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/realmKey.png"); background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-background-scale-mode: scale-to-fit; }
.currency__icon { border-radius: 0; width: 44px; height: 44px; }

/* bottom navigation icons */
.nav__item { padding-top: 92px; padding-bottom: 6px; }
.nav__icon { position: absolute; top: 4px; left: 50%; translate: -50% 0; width: 88px; height: 88px; -unity-background-scale-mode: scale-to-fit; transition-duration: 0.12s; transition-property: scale; }
.nav__item--active .nav__icon { scale: 1.15 1.15; }
.nav__item--main .nav__icon { width: 108px; height: 108px; top: -18px; }
.nav__icon--town { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/navTown.png"); }
.nav__icon--adventure { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/navAdventure.png"); }
.nav__icon--campaign { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/navCampaign.png"); }
.nav__icon--heroes { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/navHeroes.png"); }
.nav__icon--summon { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/navSummon.png"); }

/* round picture buttons */
.icon-btn { width: 84px; height: 84px; margin: 4px; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; transition-duration: 0.08s; transition-property: scale; }
.icon-btn:active { scale: 0.92 0.92; }
.icon-btn--back { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/back.png"); }
.icon-btn--close { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/close.png"); }
.icon-btn--info { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/info.png"); }

/* Fragment Aspects */
.aspect-dot { width: 40px; height: 40px; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; }
.aspect-dot.aspect--ravak { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/aspectRavak.png"); background-color: rgba(0, 0, 0, 0); }
.aspect-dot.aspect--somnara { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/aspectSomnara.png"); background-color: rgba(0, 0, 0, 0); }
.aspect-dot.aspect--envyra { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/aspectEnvyra.png"); background-color: rgba(0, 0, 0, 0); }
.aspect-dot.aspect--gorath { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/aspectGorath.png"); background-color: rgba(0, 0, 0, 0); }
.aspect-dot.aspect--veloria { background-image: url("project://database/Assets/Mythwake/Content/UI/Icons/aspectVeloria.png"); background-color: rgba(0, 0, 0, 0); }

/* hero card grade frames */
.hero-card { border-width: 0; border-radius: 10px; background-color: #141a2c; }
.hero-card__frame { position: absolute; left: -6px; top: -6px; right: -6px; bottom: -6px; -unity-background-scale-mode: stretch-to-fill; }
.hero-card--common > .hero-card__frame { background-image: url("project://database/Assets/Mythwake/Content/UI/Chrome/cardCommon.png"); }
.hero-card--rare > .hero-card__frame { background-image: url("project://database/Assets/Mythwake/Content/UI/Chrome/cardRare.png"); }
.hero-card--epic > .hero-card__frame { background-image: url("project://database/Assets/Mythwake/Content/UI/Chrome/cardEpic.png"); }
.hero-card--legendary > .hero-card__frame { background-image: url("project://database/Assets/Mythwake/Content/UI/Chrome/cardLegendary.png"); }
.hero-card--transcendent > .hero-card__frame { background-image: url("project://database/Assets/Mythwake/Content/UI/Chrome/cardTranscendent.png"); }

/* painted screen backgrounds */
.screen--solid { background-image: url("project://database/Assets/Mythwake/Content/UI/Backgrounds/bg_menu.png"); -unity-background-scale-mode: scale-and-crop; }
.screen--summon { background-image: url("project://database/Assets/Mythwake/Content/UI/Backgrounds/bg_summon.png"); }
.screen--heroes { background-image: url("project://database/Assets/Mythwake/Content/UI/Backgrounds/bg_heroes.png"); }
.screen--shop { background-image: url("project://database/Assets/Mythwake/Content/UI/Backgrounds/bg_shop.png"); }
.screen--guild { background-image: url("project://database/Assets/Mythwake/Content/UI/Backgrounds/bg_guild.png"); }
.boot { background-image: url("project://database/Assets/Mythwake/Content/UI/Backgrounds/bg_splash.png"); -unity-background-scale-mode: scale-and-crop; }
.boot__text { position: absolute; left: 0; right: 0; bottom: 140px; -unity-text-align: middle-center; color: var(--text); -unity-text-outline-width: 1px; -unity-text-outline-color: black; }

/* icons from the UI kit by name */
.ui-icon { width: 48px; height: 48px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.tag--icon { flex-direction: row; align-items: center; padding-left: 6px; }
.tag__icon { width: 36px; height: 36px; margin-right: 6px; }
.stat-row__icon { width: 40px; height: 40px; margin-right: 10px; }

